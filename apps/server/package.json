    "@prisma/client": "^6.0.0",
    "fastify": "^5.0.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "prisma": "^6.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "ws": "^8.18.0",
    "@types/ws": "^8.5.0"
  }
}
