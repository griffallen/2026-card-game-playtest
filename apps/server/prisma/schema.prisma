generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  isAdmin      Boolean   @default(false)
  createdAt    DateTime  @default(now())
  sessions     Session[]
  decks        Deck[]
  hostGames    Game[]    @relation("host")
  guestGames   Game[]    @relation("guest")
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model RulesVersion {
  id        String   @id @default(cuid())
  name      String   @unique
  config    Json
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Card {
  slug         String     @id
  name         String
  color        String
  type         String
  cost         Int
  power        Int?
  health       Int?
  text         String
  effects      Json
  artUrl       String?
  designerNote String?
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deckCards    DeckCard[]
}

model Deck {
  id          String     @id @default(cuid())
  name        String
  description String     @default("")
  color       String     @default("neutral")
  ownerId     String?
  owner       User?      @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  isPrebuilt  Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  cards       DeckCard[]
}

model DeckCard {
  deckId   String
  cardSlug String
  count    Int
  deck     Deck   @relation(fields: [deckId], references: [id], onDelete: Cascade)
  card     Card   @relation(fields: [cardSlug], references: [slug], onDelete: Restrict)

  @@id([deckId, cardSlug])
}

model Game {
  id          String      @id @default(cuid())
  name        String
  status      String      @default("waiting") // waiting | active | finished | abandoned
  seed        Int
  rulesConfig Json
  cardSet     Json
  hostId      String
  host        User        @relation("host", fields: [hostId], references: [id], onDelete: Cascade)
  guestId     String?
  guest       User?       @relation("guest", fields: [guestId], references: [id], onDelete: SetNull)
  hostDeck    Json // { name, slugs: string[] }
  guestDeck   Json?
  currentSeq  Int         @default(0)
  stateCache  Json?
  winnerSeat  Int?
  winReason   String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  finishedAt  DateTime?
  events      GameEvent[]
}

model GameEvent {
  id        String   @id @default(cuid())
  gameId    String
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  seq       Int
  actorSeat Int
  action    Json
  createdAt DateTime @default(now())

  @@unique([gameId, seq])
}
