# Local dev (Homebrew Postgres: `createdb cardgame_dev cardgame_test`)
DATABASE_URL=postgresql://localhost:5432/cardgame_dev
# Tests REFUSE to run if this matches DATABASE_URL
DATABASE_URL_TEST=postgresql://localhost:5432/cardgame_test
# Unpooled connection for migrations (Neon: use the "Direct connection" string).
# Locally, same as DATABASE_URL.
DIRECT_URL=postgresql://localhost:5432/cardgame_dev
PORT=3000
# Used once by `npm run db:seed` to create the admin account
ADMIN_PASSWORD=change-me
